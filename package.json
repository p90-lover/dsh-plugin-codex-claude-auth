{
  "name": "dsh-oauth-model-providers",
  "version": "0.9.0",
  "description": "DeepSeek Harness OAuth provider control center: authenticated account management, context controls, safe fallback and portable task handoff",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./openai": {
      "types": "./lib/openai.d.ts",
      "import": "./lib/openai.js"
    },
    "./anthropic": {
      "types": "./lib/anthropic.d.ts",
      "import": "./lib/anthropic.js"
    },
    "./handoff": {
      "types": "./lib/handoff.d.ts",
      "import": "./lib/handoff.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README.zh.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "config/examples",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "test:browser": "node scripts/browser-qa.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
